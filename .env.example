DATABASE_URL=postgresql://plan-self:plan-self@postgres:5432/plan_self
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
APP_BASE_URL=https://plan-self.home.arpa:8443
PLAN_SELF_HTTP_PORT=8080
PLAN_SELF_HTTPS_PORT=8443
# Internal container URL. Browsers use the same-origin /api proxy instead.
API_BASE_URL=http://api:3001
AIR_GAPPED=true
FILE_STORAGE_PATH=/data/files
SETUP_WIZARD_ENABLED=true
ENABLE_AI=false
AI_PROVIDER=ollama
UPLOAD_PROVIDER=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GATEWAY_PORT=3010
GATEWAY_URL=http://gateway:3010
GATEWAY_SECRET=change-me-gateway
# Browser API and WebSocket traffic use the reverse proxy on the current origin.
